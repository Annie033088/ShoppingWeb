@{ Layout = "~/Views/Shared/MainHomeLayout.cshtml"; }
@{
    ViewBag.Title = "商品管理";
}


<body>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <link href="~/css/MainProduct.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <main>
        <h2 class="text-center mb-3">@ViewBag.Title</h2>
        <div id="navCategory" class="text-center col-sm-12 row justify-content-center mb-1">
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="getProductByCategory(1,1)" data-id="1">新品</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="getProductByCategory(2,1)" data-id="2">特價</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="getProductByCategory(3,1)" data-id="3">用品</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="getProductByCategory(4,1)" data-id="4">飼料</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="getProductByCategory(5,1)" data-id="5">罐頭</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="getProductByCategory(6,1)" data-id="6">零食</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="getProductByCategory(7,1)" data-id="7">貓砂</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="getProductByCategory(8,1)" data-id="8">保健</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="getProductByCategory(9,1)" data-id="9">生活</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="getProductByCategory(10,1)" data-id="10">品牌</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="getProductByCategory(11,1)" data-id="11">其他</button>
        </div>
        <div class="d-flex justify-content-center mb-1">
            <button type="button" id="btnAdd" class="btn btn-outline-dark me-2" onclick='location.href="/MainProduct/CreateProduct"'>新增</button>
            <button type="button" id="btnGetAllProduct" class="btn btn-outline-dark me-5" onclick='getAll()'>查詢全部</button>
            <label class="me-1 align-content-center">輸入搜尋ID：</label>
            <input type="text" class="form-control me-1" id="txbSelectProductId" style="max-width: 200px;" required />
            <button type="button" id="btnSelectByProductId" class="btn btn-outline-dark me-2">搜尋</button>

            <label class="me-1  align-content-center">輸入搜尋商品名：</label>
            <input type="text" class="form-control me-1" id="txbSelectProductName" style="max-width: 200px;" required />
            <button type="button" id="btnSelectByProductName" class="btn btn-outline-dark me-1">搜尋</button>
        </div>

        <table id="productTable" class="table" style="table-layout:fixed" border="1">
            <thead>
                <tr class="bg-gradient text-bg-dark ">
                    <th scope="col">#</th>
                    <th scope="col">Id<button id="sortById" class="btn btnSort"></button></th>
                    <th scope="col">商品名稱<button id="sortByEmail" class="btn btnSort"></button></th>
                    <th scope="col">分類<button id="sortByPhone" class="btn btnSort"></button></th>
                    <th scope="col">狀態<button id="sortByStatus" class="btn btnSort"></button></th>
                    <th scope="col">操作選項</th>
                </tr>
            </thead>
            <tbody>
                <!-- 用來插入用戶資料的行將在這裡 -->
            </tbody>
        </table>
        <nav aria-label="Data navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item"><button class="page-link" id="previousPage" onclick="previousPage()">Previous</button></li>
                <li class="page-item"><button class="page-link" id="firstPage" onclick="firstPage()">1</button></li>
                <li class="page-item ms-1 me-1">...</li>
                <li class="page-item"><button class="page-link" id="currentPage">1</button></li>
                <li class="page-item ms-1 me-1">...</li>
                <li class="page-item"><button class="page-link" id="lastPage" onclick="lastPage()">9</button></li>
                <li class="page-item"><button class="page-link" id="nextPage" onclick="nextPage()">Next</button></li>
            </ul>
        </nav>
        <script>

            let lastCategoryId = 0;
            let lastGetProductId = 0;
            let lastGetProductName = " ";

            getAll();

            document.getElementById("btnSelectByProductId").addEventListener('click', function () {
                const selectId = document.getElementById("txbSelectProductId").value;
                const regexId = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;

                if (!regexId.test(selectId)) {
                    Swal.fire("請輸入正確的id!");
                    return;
                }

                getProductById(selectId, 1);
            })

            document.getElementById("btnSelectByProductName").addEventListener('click', function () {
                const selectName = document.getElementById("txbSelectProductName").value;
                const regexName = /^[^\s].{0,29}$/;

                if (!regexName.test(selectName)) {
                    Swal.fire("請輸入30字以內商品名(第一個字不得為空)");
                    return;
                }

                getProductByName(selectName, 1);
            })

            function getAll() {
                lastGetProductId = 0;
                lastCategoryId = 0;
                let lastGetProductName = " ";
                getAllProduct(1);
            }

            function firstPage() {
                document.getElementById("currentPage").innerHTML = 1;

                if (lastCategoryId != 0) {
                    getProductByCategory(lastCategoryId, 1);
                }
                else if (lastGetProductId != 0) {
                    getProductById(lastGetProductId, 1)
                }
                else if (lastGetProductName != " ") {
                    getProductById(lastGetProductId, 1)
                }
                else {
                    getAllProduct(1);
                }
            }

            function previousPage() {
                let oldCurrentPage = parseInt(document.getElementById("currentPage").innerHTML);
                let newCurrentPage = oldCurrentPage;

                if (oldCurrentPage > 1) {
                    newCurrentPage = oldCurrentPage - 1;
                    document.getElementById("currentPage").innerHTML = newCurrentPage;
                }
                else {
                    newCurrentPage = 1
                }

                if (lastCategoryId != 0) {
                    getProductByCategory(lastCategoryId, newCurrentPage);
                }
                else if (lastGetProductId != 0) {
                    getProductById(lastGetProductId, newCurrentPage)
                }
                else if (lastGetProductName != " ") {
                    getProductById(lastGetProductId, 1)
                }
                else {
                    getAllProduct(newCurrentPage);
                }
            }

            function nextPage() {
                let oldCurrentPage = parseInt(document.getElementById("currentPage").innerHTML);
                let maxPage = parseInt(document.getElementById("lastPage").innerHTML)
                let newCurrentPage = oldCurrentPage

                if (oldCurrentPage < maxPage) {
                    newCurrentPage = oldCurrentPage + 1;
                    document.getElementById("currentPage").innerHTML = newCurrentPage;
                }
                else {
                    newCurrentPage = maxPage;
                }

                if (lastCategoryId != 0) {
                    getProductByCategory(lastCategoryId, newCurrentPage);
                }
                else if (lastGetProductId != 0) {
                    getProductById(lastGetProductId, newCurrentPage)
                }
                else if (lastGetProductName != " ") {
                    getProductById(lastGetProductId, 1)
                }
                else {
                    getAllProduct(newCurrentPage);
                }
            }

            function lastPage() {
                let maxPage = parseInt(document.getElementById("lastPage").innerHTML);
                document.getElementById("currentPage").innerHTML = maxPage;

                if (lastCategoryId != 0) {
                    getProductByCategory(lastCategoryId, maxPage);
                }
                else if (lastGetProductId != 0) {
                    getProductById(lastGetProductId, maxPage)
                }
                else if (lastGetProductName != " ") {
                    getProductById(lastGetProductId, 1)
                }
                else {
                    getAllProduct(maxPage);
                }
            }

            function getAllProduct(page) {
                axios.post("/MainProduct/GetAllProduct", { Page: page })
                    .then(response => {
                        if (response.data.Item1 != "noProduct") {
                            populateTable(response.data.Item1);
                            document.getElementById("lastPage").innerHTML = response.data.Item2;
                        }
                    })
                    .catch(error => {
                        console.error("fail", error);
                    })
            }

            function getProductByCategory(lastSelectCategoryId, page) {

                document.getElementById("currentPage").innerHTML = 1;
                lastGetProductName = " ";
                lastGetProductId = 0;
                lastCategoryId = lastSelectCategoryId;

                axios.post("/MainProduct/GetProductByCategory", { LastSelectCategoryId: lastSelectCategoryId, Page: page })
                    .then(response => {
                        if (response.data != "noProduct") {
                            populateTable(response.data.Item1);
                            document.getElementById("lastPage").innerHTML = response.data.Item2;
                        } else {
                            document.getElementById("productTable").getElementsByTagName('tbody')[0].innerHTML = "";
                            document.getElementById("lastPage").innerHTML = 1
                        }
                    })
                    .catch(error => {
                        console.error("fail", error);
                    })
            }

            function getProductById(lastSelectProductId, page) {

                document.getElementById("currentPage").innerHTML = 1;
                lastGetProductName = " ";
                lastGetProductId = lastSelectProductId;
                lastCategoryId = 0;

                axios.post("/MainProduct/GetProductById", { LastSelectProductId: lastSelectProductId, Page: page })
                    .then(response => {
                        if (response.data) {
                            populateTable(response.data.Item1);
                            document.getElementById("lastPage").innerHTML = response.data.Item2;
                        } else {
                            
                            document.getElementById("productTable").getElementsByTagName('tbody')[0].innerHTML = "";
                            document.getElementById("lastPage").innerHTML = 1;
                        }
                    })
                    .catch(error => {
                        console.error("fail", error);
                    })
            }

            function getProductByName(lastSelectProductName, page) {

                document.getElementById("currentPage").innerHTML = 1;
                lastGetProductName = lastSelectProductName;
                lastGetProductId = 0;
                lastCategoryId = 0;

              axios.post("/MainProduct/GetProductByName", { LastSelectProductName: lastSelectProductName, Page: page })
                    .then(response => {
                        console.log(response.data);
                        if (response.data != "noProduct") {
                            populateTable(response.data.Item1);
                            document.getElementById("lastPage").innerHTML = response.data.Item2;
                        } else {
                            document.getElementById("productTable").getElementsByTagName('tbody')[0].innerHTML = "";
                            document.getElementById("lastPage").innerHTML = 1;
                        }
                    })
                    .catch(error => {
                        console.error("fail", error);
                    })
            }

            function populateTable(products) {
                const tableBody = document.getElementById("productTable").getElementsByTagName('tbody')[0];
                tableBody.innerHTML = '';

                products.forEach((product, index) => {
                    const row = document.createElement('tr');
                    const rowSort = document.createElement('th');
                    rowSort.textContent = index + 1;
                    rowSort.scope = "row";
                    row.appendChild(rowSort);

                    const cellId = document.createElement('td');
                    cellId.textContent = product.ProductId;

                    row.appendChild(cellId);

                    const cellName = document.createElement('td');
                    cellName.textContent = product.Name;
                    row.appendChild(cellName);

                    const cellCategory = document.createElement('td');
                    cellCategory.textContent = productCategoryIdToText(product.CategoryId);
                    row.appendChild(cellCategory);

                    const cellStatus = document.createElement('td');
                    cellStatus.textContent = product.Status ? "上架" : "下架";
                    row.appendChild(cellStatus);

                    const cellEdit = document.createElement('td');

                    const cellEditBtn = document.createElement("button");
                    cellEditBtn.className = "btnEditProduct";
                    cellEditBtn.addEventListener("click", function () {
                        window.location.href = `/MainProduct/ProductDetail?ProductId=${product.ProductId}`;
                    });
                    cellEdit.appendChild(cellEditBtn);

                    const cellDeleteBtn = document.createElement("button");
                    cellDeleteBtn.className = "btnDeleteProduct";
                    cellDeleteBtn.addEventListener("click", function () {
                        delProduct(product.ProductId);
                    });
                    cellEdit.appendChild(cellDeleteBtn);

                    row.appendChild(cellEdit)


                    // 把這一行加到表格中
                    tableBody.appendChild(row);
                });
            }

            function delProduct(productId) {
                Swal.fire({
                    title: '確定要刪除這個項目嗎？',
                    text: "這個操作無法恢復！",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: '刪除',
                    cancelButtonText: '取消'
                }).then((result) => {
                    if (result.isConfirmed) {
                        axios.post("/MainProduct/DeleteProduct", { ProductId: productId })
                            .then(response => {
                                if (response.data == true) {
                                    Swal.fire("刪除成功")
                                        .then(result => {
                                            window.location.href = "/MainProduct/Index";
                                        })
                                } else {
                                    Swal.fire("刪除失敗");
                                }
                            })
                            .catch(error => { console.error(error) })
                    }
                })
            }

            function productCategoryIdToText(categoryId) {
                switch (categoryId) {
                    case 1:
                        return "新品";
                        break;
                    case 2:
                        return "特價";
                        break;
                    case 3:
                        return "用品";
                        break;
                    case 4:
                        return "飼料";
                        break;
                    case 5:
                        return "罐頭";
                        break;
                    case 6:
                        return "零食";
                        break;
                    case 7:
                        return "貓砂";
                        break;
                    case 8:
                        return "保健";
                        break;
                    case 9:
                        return "生活";
                        break;
                    case 10:
                        return "品牌";
                        break;
                    default:
                        return "其他";
                        break;
                }
            }


        </script>
    </main>
</body>
