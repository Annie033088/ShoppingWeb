@{ Layout = "~/Views/Shared/MainHomeLayout.cshtml"; }
@{
    ViewBag.Title = "商品管理";
}


<body>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <link href="~/css/Product.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <main>
        <h2 class="text-center mb-3">@ViewBag.Title</h2>
        <div id="navCategory" class="text-center col-sm-12 row justify-content-center">
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="">全部</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="">新品</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="">特價</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="">用品</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="">飼料</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="">罐頭</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="">零食</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="">貓砂</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="">保健</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="">生活</button>
            <button class="col-1 h5 btn btn-outline-secondary me-1" onclick="">品牌</button>
        </div>
        <div>
            <button type="button" id="btnAddProduct" class="btn btn-outline-dark" onclick='window.location.href="/MainProduct/CreateProduct"'>新增商品</button>
        </div>
        <div id="productList" class="container text-center">

        </div>
        <nav aria-label="Data navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item"><button class="page-link" id="previousPage" onclick="">Previous</button></li>
                <li class="page-item"><button class="page-link" id="firstPage" onclick="">1</button></li>
                <li class="page-item ms-1 me-1">...</li>
                <li class="page-item"><button class="page-link" id="currentPage">1</button></li>
                <li class="page-item ms-1 me-1">...</li>
                <li class="page-item"><button class="page-link" id="lastPage" onclick="">9</button></li>
                <li class="page-item"><button class="page-link" id="nextPage" onclick="">Next</button></li>
            </ul>
        </nav>
        <script>

            let lastCategoryId = "All";

            getAll();

            function getAll() {
                lastCategoryId = "All";
                getAllProduct(1);
            }

            function firstPage() {
                document.getElementById("currentPage").innerHTML = 1;

                if (lastCategoryId == "All") {
                    getAllProduct(1);
                }
                else
                {
                    getProductByCategory(lastCategoryId, 1);
                }
            }

            function previousPage() {
                let oldCurrentPage = parseInt(document.getElementById("currentPage").innerHTML);
                let newCurrentPage = oldCurrentPage;

                if (oldCurrentPage > 1) {
                    newCurrentPage = oldCurrentPage - 1;
                    document.getElementById("currentPage").innerHTML = newCurrentPage;
                }
                else {
                    newCurrentPage = 1
                }

                if (lastCategoryId == "All") {
                    getAllProduct(newCurrentPage);
                }
                else
                {
                    getProductByCategory(lastCategoryId, newCurrentPage);
                }
            }

            function nextPage() {
                let oldCurrentPage = parseInt(document.getElementById("currentPage").innerHTML);
                let maxPage = parseInt(document.getElementById("lastPage").innerHTML)
                let newCurrentPage = oldCurrentPage

                if (oldCurrentPage < maxPage) {
                    newCurrentPage = oldCurrentPage + 1;
                    document.getElementById("currentPage").innerHTML = newCurrentPage;
                }
                else {
                    newCurrentPage = maxPage;
                }

                if (lastCategoryId == "All")
                {
                    getAllProduct(newCurrentPage);
                }
                else
                {
                    getProductByCategory(lastCategoryId, newCurrentPage);
                }
            }

            function lastPage() {
                let maxPage = parseInt(document.getElementById("lastPage").innerHTML);
                document.getElementById("currentPage").innerHTML = maxPage;

                if (lastCategoryId == "All") {
                    getAllProduct(maxPage);
                }
                else
                {
                    getProductByCategory(lastCategoryId, maxPage);
                }
            }

            function getAllProduct(page) {
                axios.post("/MainProduct/GetAllProduct", { Page: page })
                    .then(response => {
                        if (response.data.Item1 != "noProduct") {
                            populateProduct(response.data.Item1);
                            document.getElementById("lastPage").innerHTML = response.data.Item2;
                        }
                    })
                    .catch(error => {
                        console.error("fail", error);
                    })
            }

            function getProductByCategory(selectCategoryName, lastSelectCategoryId, page) {

                document.getElementById("currentPage").innerHTML = 1;
                lastCategoryId = selectCategoryName;

                axios.post("/Product/GetProductByCategory", { LastSelectCategoryId: lastSelectCategoryId,  Page: page })
                    .then(response => {
                        if (response.data != "noProduct") {
                            populateProduct(response.data.Item1);
                            document.getElementById("lastPage").innerHTML = response.data.Item2;
                        } else {
                            document.getElementById("productList").innerHTML = "";
                        }
                    })
                    .catch(error => {
                        console.error("fail", error);
                    })
            }

            function populateProduct(products) {
                var productList = document.getElementById("productList");
                productList.innerHTML = '';

                for (let i = 0; i < products.ProductId.length; i++) {
                    var productBox = document.createElement('div');
                    productBox.className = "col-2";
                    var productPicBox = document.createElement('div');
                    var productPicUrl = document.createElement('a');
                    var productPic = document.createElement('img');
                    productPic.src = products.ImageUrl[i];
                    productPicUrl.className = "btn";
                    productPicUrl.addEventListener('click', function () { getToProductDetail(products.ProductId[i]) })
                    productPicUrl.appendChild(productPic);
                    productPicBox.appendChild(productPicUrl);

                    var productTitleBox = document.createElement('div');
                    var productTitle = document.createElement('a');
                    productTitle.innerHTML = products.ProductId[i] + ". " + products.Name[i];
                    productPicUrl.className = "btn";
                    productTitle.addEventListener('click', function () { getToProductDetail(products.ProductId[i])})
                    var productPrice = document.createElement('p');
                    productPrice.innerHTML = products.Price[i];
                    var stockWarning = document.createElement('p');
                    stockWarning.className = "text-danger";

                    if (products.StockQuantity[i] == 0) {
                        stockWarning.innerHTML = "庫存量不足";
                    }
                    else if (products.StockQuantity[i] <= 3)
                    {
                        stockWarning.innerHTML = "庫存量即將不足";
                    } else
                    {
                        stockWarning.innerHTML = "";
                    }

                    productTitleBox.appendChild(productTitle);
                    productTitleBox.appendChild(productPrice);
                    productTitleBox.appendChild(stockWarning);

                    productBox.appendChild(productPicBox);
                    productBox.appendChild(productTitleBox);

                    productList.appendChild(productBox);
                };
            }

            function getToProductDetail(ProductId) {
                window.location.href = `/Product/GetProductDetail?ProductId=${ProductId}`;
            }
        </script>
    </main>
</body>
