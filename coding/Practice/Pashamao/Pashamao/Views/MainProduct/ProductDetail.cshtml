
@{ Layout = "~/Views/Shared/MainHomeLayout.cshtml"; }
@{
    ViewBag.Title = "商品信息";
}


<body>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <link href="~/css/ProductDetail.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <main>
        <div class="d-flex">
            <div class="" style="width:5%">
                <button class="btn btn-dark" style="" onclick="window.location.href='/MainProduct/Index'"> 返回</button>
            </div>
            <div class="" style="width:95%">
                <h2 class="text-center mb-3">@ViewBag.Title</h2>
            </div>
        </div>
        <div class="">

            <div id="productDetailBox" class="d-flex" style="height: 100%; width: 100%; ">
                <div class=" col-5 card">
                    <div class="card-header text-center">
                        商品主要內容：
                    </div>


                    <div id="imageBox" class="mt-3 " style="flex-wrap: wrap; ">
                        <div id="navImageBox" class="navImageBox ms-5" style="width: 50%; overflow: hidden; display: flex; position: relative">
                            <div id="navImageContainer" class="navImageContainer">
                                <img id="navImage1" src="#" class="me-2 navImage" style="width: 25%; height:100%" />
                            </div>
                        </div>
                        <button id="btnEditImage" class="btn btn-dark mt-1 ms-5" style=" width: 50%; opacity:0.9" onclick="">修改圖片</button>
                    </div>

                    <div id="productNameBox" class="input-group mt-3">
                        <span class="input-group-text w-25">商品名稱</span>
                        <input id="txbName" type="text" class="form-control" style="">
                    </div>

                    <div id="productDescriptionBox" class="input-group mt-3">
                        <span class="input-group-text w-25">商品簡述</span>
                        <input id="txbDescription" type="text" class="form-control" style="">
                    </div>

                    <div class="input-group mt-3 d-flex flex-wrap w-75">
                        <span class="input-group-text w-25">分類</span>
                        <div style="width: 15%; height:100% ;text-align: center;" class="me-1">
                            <span id="txtCategory" class="form-control " style=" height:100%;"></span>
                        </div>
                    </div>

                    <div id="productCategoryBox" class="input-group mt-1 d-flex flex-wrap w-75">

                    </div>

                    <div id="productIntroduceBox" class="mt-3 d-flex" style="">
                        <span id="" class="input-group-text ">商品介紹：</span>
                        <textarea class="form-control " id="productIntroduce" style="resize:none" placeholder="在此輸入內容..."></textarea>

                    </div>

                    <div id="productStatusBox" class="mt-3" style="display:flex">
                        <span id="txtProductStatus" class="input-group-text">商品狀態：上架；</span>
                        <button id="btnProductStatusOn" class="btn btn-dark" type="button" disabled>上架</button>
                        <button id="btnProductStatusOff" class="btn btn-dark">下架</button>
                    </div>

                    <div class="d-flex mt-3">
                        <button class="btn btn-success" style="" onclick="editProduct()"> 確認修改</button>
                    </div>


                </div>
                <div class=" col-7 card">
                    <div class="card-header text-center mb-1">
                        細分項目：
                    </div>
                    <table id="memberTable" class="table " style="table-layout:fixed" border="1">
                        <thead>
                            <tr class="table-secondary ">
                                <th scope="col">#</th>
                                <th scope="col">項目名<button id="sortByEmail" class="btn btnSort"></button></th>
                                <th scope="col">圖片<button id="sortById" class="btn btnSort"></button></th>
                                <th scope="col">數量<button id="sortByPhone" class="btn btnSort"></button></th>
                                <th scope="col">價格<button id="sortByMemberName" class="btn btnSort"></button></th>
                                <th scope="col">狀態<button id="sortByStatus" class="btn btnSort"></button></th>
                                <th scope="col">操作選項</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- 用來插入用戶資料的行將在這裡 -->
                        </tbody>
                    </table>

                </div>

            </div>

        </div>
    </main>
</body>
