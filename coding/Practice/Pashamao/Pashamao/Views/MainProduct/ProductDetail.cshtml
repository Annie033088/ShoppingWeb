
@{ Layout = "~/Views/Shared/MainHomeLayout.cshtml"; }
@{
    ViewBag.Title = "修改商品";
}

<body>
    <link href="~/css/CreateProduct.css" rel="stylesheet" type="text/css" />
    <main>
        <div class="d-flex">
            <div class="" style="width:5%">
                <button class="btn btn-dark" style="" onclick="window.location.href='/MainProduct/Index'"> 返回</button>
            </div>
            <div class="" style="width:95%">
                <h2 class="text-center mb-3">@ViewBag.Title</h2>
            </div>
        </div>
        <div class="">

            <div id="productDetailBox" class="d-flex" style="height: 100%; width: 100%; ">
                <div class=" col-6 card">
                    <div class="card-header text-center">
                        商品主要內容：
                    </div>


                    <div id="imageBox" class="mt-3 h-50 card-header " style="flex-wrap: wrap; ">
                        <div id="displayImageBox" class="navImageBox ms-5 w-50" style=" overflow: hidden; display: flex; position: relative">
                            <button id="btnPrevious" class="btn btn-dark btnNav" style="position: absolute; width: 5%; height: 100%" onclick="imagePrevious()"></button>
                            <div id="displayImageContainer" class="displayImageContainer d-flex">
                            </div>
                            <button id="btnNext" class="btn btn-dark btnNav" style="position: absolute; right: 0; width: 5%; height: 100%" onclick="imageNext()"></button>
                        </div>
                        <div>
                            <button id="btnEditImage" class="btn btn-dark mt-1 ms-5" style=" width: 50%; opacity:0.9" onclick="getImageAndEdit()">上傳/修改展示圖片</button>
                            <button id="btnSubmitEditImage" class="btn btn-success  mt-1 ms-1" style=" width: 18%; opacity:0.9" onclick="submitEditImage()">確認修改</button>
                        </div>
                    </div>

                    <div id="productNameBox" class="input-group mt-3">
                        <span class="input-group-text w-25">商品名稱</span>
                        <input id="txbName" type="text" class="form-control" style="">
                    </div>

                    <div id="productDescriptionBox" class="input-group mt-3">
                        <span class="input-group-text w-25">商品簡述</span>
                        <input id="txbDescription" type="text" class="form-control" style="">
                    </div>

                    <div class="input-group mt-3 d-flex flex-wrap ">
                        <span class="input-group-text w-25">分類</span>
                        <div style=" height:100% ;text-align: center;" class="me-1">
                            <select id="dropdownCategory" class="form-select form-select-sm" name="category">
                                <option value="3">用品</option>
                                <option value="4">飼料</option>
                                <option value="5">罐頭</option>
                                <option value="6">零食</option>
                                <option value="7">貓砂</option>
                                <option value="8">保健</option>
                                <option value="9">生活</option>
                                <option value="10">品牌</option>
                                <option value="11" selected>其他</option>
                            </select>
                        </div>
                    </div>

                    <div id="productIntroduceBox" class="mt-3 d-flex" style="">
                        <span id="" class="input-group-text ">商品介紹</span>
                        <textarea class="form-control " id="productIntroduce" style=" resize:none" placeholder="在此輸入內容..."></textarea>

                    </div>

                    <div id="productStatusBox" class="mt-3" style="display:flex">
                        <span id="txtProductStatus" class="input-group-text">上/下架</span>
                        <button id="btnProductStatusOn" class="" type="button" onclick="setProductStatusOn()">上架</button>
                        <button id="btnProductStatusOff" class="" onclick="setProductStatusOff()">下架</button>
                        <button id="btnSubmitEditProduct" class="btn btn-success" style=" width: 15%; opacity:0.9; margin-left:170px" onclick="submitEditProduct()">確認修改</button>
                    </div>


                </div>
                <div class=" col-6 card">
                    <div class="card-header text-center mb-1">
                        細分項目：
                    </div>
                    <table id="styleTable" class="table " style="table-layout:fixed" border="1">
                        <thead>
                            <tr class="table-success">
                                <th scope="col">項目名<button id="" class="btn btnSort"></button></th>
                                <th scope="col">圖片<button id="" class="btn btnSort"></button></th>
                                <th scope="col">數量<button id="" class="btn btnSort"></button></th>
                                <th scope="col">價格<button id="" class="btn btnSort"></button></th>
                                <th scope="col">狀態<button id="" class="btn btnSort"></button></th>
                                <th scope="col">操作選項</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                    <div class="card-footer d-flex justify-content-center ">
                        <button class="btn btnAdd" style="" onclick="addStyle()"> </button>
                    </div> 
                </div>
            </div>
        </div>
    </main>
    <script>var productData = @Html.Raw(ViewBag.JsonData);</script>
    <script src="~/js/productDetail.js"></script>
</body>
