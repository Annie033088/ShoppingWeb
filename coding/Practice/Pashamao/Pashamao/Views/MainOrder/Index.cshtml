@{
    ViewBag.Title = "訂單管理";
}

<body>
    <link href="~/css/Order/Order.css" rel="stylesheet" type="text/css" />
    <script src="~/js/MainOrder/GetMainOrderIndex.js"></script>
    <main>
        <h2 class="text-center mb-3">@ViewBag.Title</h2>
        <div class=" mb-1">
            <div class="d-flex mb-1 w-100 h-100">
                <div class="d-flex">
                    <button type="button" id="btnGetAllOrder" class="btn btn-outline-dark me-5" onclick='getAll()'>查詢全部</button>
                </div>
                <div class="d-flex mt-1" style="">
                    <label class="me-1 align-content-center">訂單編號：</label>
                    <input type="text" class="form-control me-1" id="txbSelectOrderNumber" style="width: 200px" required />
                    <button type="button" id="btnSelectByOrderNumber" class="btn btn-outline-dark me-2">搜尋</button>
                </div>

                <div class="d-flex mt-1 me-3">
                    <label class="me-1  align-content-center">電話末三碼：</label>
                    <input type="text" class="form-control me-1" style="width:60px;" id="txbSelectPhone" required />
                    <button type="button" id="btnSelectByPhone" class="btn btn-outline-dark me-1">搜尋</button>
                </div>

                <div class="d-flex mt-1 me-3">
                    <label class="me-1  align-content-center">會員Id：</label>
                    <input type="text" class="form-control me-1" style="width:100px;" id="txbSelectMemberId" required />
                    <button type="button" id="btnSelectByMemberId" class="btn btn-outline-dark me-1">搜尋</button>
                </div>
            </div>

            <div class="d-flex mt-1" style="height:35px">
                <label class="me-1 align-content-center">日期：</label>
                <input type="date" class="form-control me-1" id="txbDateStart" style="" required />
                <label class="">~</label>
                <input type="date" class="form-control me-1" id="txbDateEnd" style="" required />
                <button type="button" id="btnSelectByDate" class="btn btn-outline-dark me-1">搜尋</button>
                <div class=" ms-1 d-flex">
                    <span class=" mt-1" style="white-space:nowrap">狀態：</span>
                    <select type="" id="selectStatus" class="form-select form-select-sm">
                        <option value="0">全部</option>
                        <option value="1">待確認</option>
                        <option value="2">待出貨</option>
                        <option value="3">已出貨</option>
                        <option value="4">完成</option>
                        <option value="5">買家未取商品</option>
                        <option value="6">重新寄回</option>
                        <option value="7">取消</option>
                        <option value="8">退貨</option>
                    </select>
                </div>
            </div>

            <div class="w-100 d-flex  justify-content-end" style="">
                <button id="btnEditOrderState" class="btn btn-outline-secondary">編輯狀態</button>
            </div>
        </div>
        <table id="orderTable" class="table" style="table-layout:fixed" border="1">
            <thead>
                <tr class="bg-gradient text-bg-dark ">
                    <th scope="col">
                        <input type="checkbox" name="name" id="ckbAllOrder"/>
                        <span>#</span>                        
                    </th>
                    <th scope="col">訂單編號</th>
                    <th scope="col">日期</th>
                    <th scope="col">會員</th>
                    <th scope="col">收件人</th>
                    <th scope="col">狀態</th>
                    <th scope="col">金額</th>
                    <th scope="col">操作選項</th>
                </tr>
            </thead>
            <tbody>
                <!-- 用來插入用戶資料的行將在這裡 -->
            </tbody>
        </table>
        <nav aria-label="Data navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item"><button class="page-link" id="previousPage" onclick="previousPage()">Previous</button></li>
                <li class="page-item"><button class="page-link" id="firstPage" onclick="firstPage()">1</button></li>
                <li class="page-item ms-1 me-1">...</li>
                <li class="page-item"><button class="page-link" id="currentPage">1</button></li>
                <li class="page-item ms-1 me-1">...</li>
                <li class="page-item"><button class="page-link" id="lastPage" onclick="lastPage()">9</button></li>
                <li class="page-item"><button class="page-link" id="nextPage" onclick="nextPage()">Next</button></li>
            </ul>
        </nav>
    </main>
</body>
