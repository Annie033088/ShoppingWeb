<body>
    <main>
        <div asp-controller="action" class="container col-3 mx-auto">
            <div class="mb-3 ">
                <label class="fs-6 ">請輸入舊密碼</label>
                <input type="password" id="oldPwd" name="OldPwd" class="form-control" placeholder="Enter 8~20 words" pattern="^(?=.*[a-zA-Z])(?=.*\d)[a-zA-Z\d]{8,20}$" required />
            </div>
            <div class="mb-3 ">
                <label class="fs-6 ">請輸入新密碼</label>
                <input type="password" id="newPwd" name="NewPwd" class="form-control" placeholder="Enter 8~20 words" pattern="^(?=.*[a-zA-Z])(?=.*\d)[a-zA-Z\d]{8,20}$" required />
            </div>
            <div>
                <button type="submit" class="btn btn-dark" onclick="submitEditUserPwd()">確認</button>
                <button type="button" class="btn btn-dark" onclick="setRedirectPage('MainHome', 'Index')">取消</button>
            </div>
        </div>
    </main>
    <script>
        function submitEditUserPwd() {
            let oldPwdValue = document.getElementById("oldPwd").value;
            let newPwdValue = document.getElementById("newPwd").value;

            //驗證登入資料
            let editPwdRegex = /^(?=.*[a-zA-Z])(?=.*\d)[a-zA-Z\d]{8,20}$/;//至少包含1個數字及英文, 長度為8~20
            if (!editPwdRegex.test(oldPwdValue) || !editPwdRegex.test(newPwdValue)) {
                Swal.fire('請輸入至少包含1個數字及英文, 長度為8~20的密碼');
                return;
            }

            if (oldPwdValue == newPwdValue) {
                Swal.fire('請勿輸入相同密碼');
                return;
            }

            let editUserPwdDto = {
                OldPwd: oldPwdValue,
                NewPwd: newPwdValue
            };

            axios.post("/MainHome/SubmitEditUserPwd", { editUserPwdDto })
                .then(response => {
                    let responseInfo = errorCodeToInfo(response.data.errorCode);
                    responseInfoHandler(responseInfo);
                })
                .catch(error => {
                    console.error("fail", error);
                });

        }
    </script>
</body>