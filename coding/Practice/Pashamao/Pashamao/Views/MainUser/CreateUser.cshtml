@{ Layout = "~/Views/Shared/MainHomeLayout.cshtml"; }

<body>
    <main>
        <form method="post" action="/MainUser/CreateUser">
            <div asp-controller="action" class="container col-3 mx-auto">
                <div class="mb-3  ">
                    <label class="fs-6 control-form-label ">帳號</label>
                    <input type="text" name="Account" class="form-control" placeholder="Enter 8~20 words" pattern="^(?=.*[a-zA-Z])(?=.*\d)[a-zA-Z\d]{8,20}$" required />
                </div>
                <div class="mb-3 ">
                    <label class="fs-6 ">密碼</label>
                    <input type="password" name="Password" class="form-control" placeholder="Enter 8~20 words" pattern="^(?=.*[a-zA-Z])(?=.*\d)[a-zA-Z\d]{8,20}$" required />
                </div>
                <div class="mb-3 ">
                    <label class="fs-6 ">名稱</label>
                    <input type="text" name="Name" class="form-control" placeholder="Enter your name" pattern="^{,10}$" />
                </div>
                <div class="mb-3 ">
                    <label class="fs-6 ">角色</label>
                    <select id="dropDownRole" name="DropDownRole">
                    </select>
                </div>
                <div>
                    <button type="submit" class="btn btn-dark">確認</button>
                    <button type="button" class="btn btn-dark" onclick="window.location.href=`/MainUser/Index`">取消</button>
                </div>
            </div>
            <p>@ViewBag.Message</p>
        </form>

    </main>
    <script>

        var JsonRoles = @Html.Raw(ViewBag.JsonRoles);
         var selectElement = document.getElementById("dropDownRole");

        JsonRoles.roles.forEach(function (role) {
            if (role.RoleId != 1) {
                var option = document.createElement("option");
                option.value = role.RoleId;
                option.textContent = role.Name;
                selectElement.appendChild(option);
            }
        })
    </script>
</body>